@model List<Opportunity>
@{ ViewData["Title"] = "Opportunities"; var q = Context.Request.Query; }
@{ var userNames = (Dictionary<string, string>)ViewBag.UserNames; string UN(string? id) => id != null && userNames.TryGetValue(id, out var n) ? n : "-"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2 class="mb-0">Opportunities</h2><a class="btn btn-primary" asp-action="Create">New Opportunity</a></div>
<form method="get" class="row g-2 mb-3">
  <div class="col-md-3"><input name="search" value="@q["search"]" class="form-control" placeholder="Opportunity or customer" /></div>
  <div class="col-md-2"><select name="status" class="form-select"><option value="">All</option>@foreach (var s in (IEnumerable<SelectListItem>)ViewBag.FilterList) { <option value="@s.Value" selected="@(q["status"] == s.Value)">@s.Text</option> }</select></div>
  @if (!User.IsInRole("SalesExecutive")) { <div class="col-md-2"><select name="assigned" class="form-select"><option value="">All users</option>@foreach (var u in (IEnumerable<SelectListItem>)ViewBag.Users) { <option value="@u.Value" selected="@(q["assigned"] == u.Value)">@u.Text</option> }</select></div> }
  <div class="col-auto"><button class="btn btn-secondary">Search</button> <a class="btn btn-outline-secondary" asp-action="Index">Reset</a></div>
</form>
<div class="table-responsive"><table class="table table-sm table-striped bg-white align-middle">
<thead><tr><th>Name</th><th>Customer</th><th>Stage</th><th>Amount</th><th>Prob.</th><th>Close</th><th>Owner</th><th></th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@(item.OpportunityName)</td><td>@(item.Customer?.CustomerName)</td><td>@(item.Stage)</td><td>@(item.Amount.ToString("N0"))</td><td>@(item.Probability + "%")</td><td>@(item.ExpectedCloseDate.ToString("dd MMM yyyy"))</td><td>@(UN(item.AssignedTo))</td>
<td class="text-end text-nowrap">
 <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.OpportunityId">Details</a>
 <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.OpportunityId">Edit</a>
 @if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.OpportunityId">Delete</a> }
</td></tr> }
@if (!Model.Any()) { <tr><td colspan="8" class="text-center text-muted">No records found.</td></tr> }
</tbody></table></div>
<p class="text-muted small">@ViewBag.Total record(s)</p>
<partial name="_Pager" />
